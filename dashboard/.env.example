# Public Firebase web-app settings (never use Admin SDK credentials here).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# Public Web Push certificate from Firebase Console > Cloud Messaging.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=
NEXT_PUBLIC_PUSH_DELIVERY_ENABLED=false
NEXT_PUBLIC_SITE_BASE_PATH=
# Local development only; Auth 9098, Firestore 8085.
NEXT_PUBLIC_USE_EMULATORS=false
